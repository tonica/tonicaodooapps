<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_lens_memory_tree" model="ir.ui.view">
    <field name="name">lens.memory.tree</field>
    <field name="model">lens.memory</field>
    <field name="arch" type="xml">
      <tree string="Lens Memories">
        <field name="name"/>
        <field name="date_taken"/>
        <field name="photographer_id"/>
        <field name="location"/>
        <field name="state"/>
      </tree>
    </field>
  </record>

  <record id="view_lens_memory_form" model="ir.ui.view">
    <field name="name">lens.memory.form</field>
    <field name="model">lens.memory</field>
    <field name="arch" type="xml">
      <form string="Lens Memory">
        <group>
          <field name="name"/>
          <field name="date_taken"/>
          <field name="photographer_id"/>
          <field name="location"/>
          <field name="camera"/>
          <field name="category_id"/>
          <field name="tag_ids" widget="many2many_tags" />
        </group>
        <group>
          <field name="photo" filename="image_filename"/>
          <field name="image_filename"/>
          <field name="notes"/>
          <field name="is_public"/>
          <field name="state"/>
        </group>
      </form>
    </field>
  </record>

  <record id="view_lens_memory_search" model="ir.ui.view">
    <field name="name">lens.memory.search</field>
    <field name="model">lens.memory</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="photographer_id"/>
        <filter name="all" help="All" default_filter="1"/>
      </search>
      </field>
  </record>

  <record id="action_lens_memory" model="ir.actions.act_window">
    <field name="name">Lens Memories</field>
    <field name="res_model">lens.memory</field>
    <field name="view_mode">tree,form</field>
  </record>

  <record id="menu_lens_memory" model="ir.ui.menu">
    <field name="name">Lens Memoria</field>
    <field name="action" ref="action_lens_memory"/>
  </record>
</odoo>
